<?xml version="1.0" encoding="utf-8"?>
<!-- YouTube-style phone player controls + the "Playback UI style" setting. -->
<resources>
    <dimen name="mobile_ytui_margin">12dp</dimen>
    <dimen name="mobile_ytui_gap">8dp</dimen>
    <dimen name="mobile_ytui_seek_height">28dp</dimen>
    <dimen name="mobile_ytui_controls_padding_bottom">8dp</dimen>

    <string name="mobile_ytui_file_details">File details</string>
    <string name="phone_player_style">Playback UI style</string>
    <string name="phone_player_style_standard">Standard</string>
    <string name="phone_player_style_compact">Compact</string>
