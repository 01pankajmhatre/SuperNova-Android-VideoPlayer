<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/phone_home_card_width"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="@dimen/phone_home_card_width"
        android:layout_height="124dp"
        android:background="#1F2B44"
        android:duplicateParentState="true"
        android:foreground="@drawable/mobile_tile_foreground">
        <ImageView
            android:id="@+id/home_poster_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />
        <TextView
            android:id="@+id/home_poster_fallback"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="6"
            android:padding="6dp"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/home_poster_overlay_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#99000000"
            android:padding="4dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/home_poster_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/home_poster_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#9FB3D1"
        android:textSize="9sp" />
</LinearLayout>
