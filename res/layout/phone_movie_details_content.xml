<?xml version="1.0" encoding="utf-8"?>
<com.github.ksoichiro.android.observablescrollview.ObservableScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/scrollView" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/scroll_content" android:paddingTop="@dimen/video_info_margin_half" android:paddingBottom="@dimen/activity_vertical_margin" android:paddingStart="16dp" android:paddingEnd="16dp" android:orientation="vertical">
        <FrameLayout android:id="@+id/poster_action_container" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:id="@+id/posterCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="top" android:paddingTop="16dp" android:paddingBottom="16dp">
                <FrameLayout android:layout_width="120dp" android:layout_height="wrap_content">
                    <androidx.cardview.widget.CardView android:layout_gravity="start" app:cardCornerRadius="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content">
                        <RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                            <ImageView android:id="@+id/poster" android:layout_width="120dp" android:layout_height="180dp" android:scaleType="fitCenter" android:adjustViewBounds="true" android:layout_gravity="center_horizontal" android:contentDescription="@null" />
                            <ImageView android:id="@+id/watched_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignEnd="@id/poster" android:layout_alignTop="@id/poster" app:srcCompat="@drawable/watched_icon_corner" android:visibility="visible" android:contentDescription="@null" />
                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp">
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/titlebar_content" android:paddingTop="0dp" android:paddingBottom="0dp" android:orientation="vertical">
                        <TextView android:id="@+id/title_view" android:layout_width="match_parent" android:textSize="24sp" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:maxLines="3" />
                        <TextView android:id="@+id/s_e_text_view" android:layout_width="wrap_content" android:layout_below="@+id/title_view" android:textSize="@dimen/video_info_medium_text" android:textStyle="bold" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
                        <TextView android:id="@+id/episode_title_view" android:layout_below="@+id/title_view" android:layout_toEndOf="@+id/s_e_text_view" android:layout_marginStart="@dimen/video_info_margin_half" android:layout_width="wrap_content" android:textStyle="italic" android:textSize="@dimen/video_info_medium_text" android:layout_height="wrap_content" android:textColor="#FFFFFF" />
                    </RelativeLayout>
                    <LinearLayout android:id="@+id/scrap_rating_container" android:layout_width="fill_parent" android:gravity="center_vertical" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/video_info_margin_half" android:orientation="vertical">
                        <TextView android:id="@+id/scrap_date" style="@style/VideoInfoFileInfo" android:layout_marginEnd="@dimen/video_info_margin_half" android:layout_marginBottom="4dp" android:textSize="13sp" android:textColor="#DFE7F2" />
                        <TextView android:id="@+id/scrap_duration" style="@style/VideoInfoFileInfo" android:layout_marginEnd="@dimen/video_info_margin_half" android:layout_marginBottom="4dp" android:textSize="13sp" android:textColor="#DFE7F2" />
                        <TextView android:id="@+id/scrap_rating" style="@style/VideoInfoFileInfo" android:drawablePadding="2dip" app:drawableLeftCompat="@drawable/little_star" android:gravity="center_vertical" android:layout_marginEnd="@dimen/video_info_margin_half" android:layout_marginBottom="4dp" android:textSize="13sp" android:textColor="#DFE7F2" />
                        <LinearLayout android:id="@+id/content_rating_container" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom" android:background="@drawable/rounded_edges" android:layout_marginBottom="4dp">
                            <TextView android:id="@+id/content_rating" android:textSize="@dimen/video_info_small_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" android:layout_marginBottom="1dp" android:gravity="center_horizontal" android:textAppearance="?android:attr/textAppearanceMedium" android:textStyle="bold" android:textColor="@color/grid_item_background" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView android:layout_marginTop="@dimen/video_info_margin_half" android:id="@+id/scrap_genre" style="@style/VideoInfoFileInfo.Title2" android:textSize="13sp" android:textColor="#DFE7F2" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
        <include layout="@layout/phone_movie_details_actions" android:id="@+id/action_buttons_container" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <androidx.cardview.widget.CardView android:gravity="start" android:layout_gravity="bottom" android:id="@+id/buttons_container" android:layout_marginTop="@dimen/video_info_cardview_top_margin" app:cardCornerRadius="@dimen/video_info_cardview_corner" app:cardElevation="@dimen/video_info_cardview_elevation" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="vertical">
            <Button android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_horizontal|bottom" android:text="@string/leanback_scrap" android:id="@+id/scrap_button" android:layout_centerHorizontal="true" android:layout_alignParentStart="false" android:background="@drawable/transparent_ripple" android:visibility="visible" />
            <Button android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_horizontal|bottom" android:text="@string/video_browser_index_file" android:id="@+id/index_button" android:layout_centerHorizontal="true" android:layout_alignParentStart="false" android:background="@drawable/transparent_ripple" />
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView android:id="@+id/cast_card" android:layout_marginTop="@dimen/video_info_cardview_top_margin" app:cardCornerRadius="@dimen/video_info_cardview_corner" app:cardElevation="@dimen/video_info_cardview_elevation" android:layout_height="wrap_content" android:layout_width="match_parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <Button android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cast_on_tv" android:id="@+id/cast_tv_button" android:background="@drawable/transparent_ripple" />
                <LinearLayout android:id="@+id/cast_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <include android:layout_width="match_parent" android:layout_height="wrap_content" layout="@layout/phone_movie_details_plot" android:layout_gravity="center_horizontal|bottom" android:layout_marginTop="@dimen/video_info_cardview_top_margin" android:id="@+id/scraper_plot_container" />
        <HorizontalScrollView android:id="@+id/source_container" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:id="@+id/source_layout" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </HorizontalScrollView>
        <include android:layout_width="match_parent" android:layout_height="wrap_content" layout="@layout/video_info2_file" android:id="@+id/info_file_container" android:layout_marginTop="@dimen/video_info_cardview_top_margin" />
        <include android:layout_width="match_parent" android:layout_height="wrap_content" layout="@layout/video_info2_subtitles" android:layout_gravity="center_horizontal|bottom" android:id="@+id/subtitles_container" android:layout_marginTop="@dimen/video_info_cardview_top_margin" />
        <include android:layout_width="match_parent" android:layout_height="wrap_content" layout="@layout/video_info2_scraper" android:layout_gravity="center_horizontal|bottom" android:id="@+id/scraper_container" />
    </LinearLayout>
</com.github.ksoichiro.android.observablescrollview.ObservableScrollView>