<?xml version="1.0" encoding="utf-8"?>
<!-- Compact phone controls (swapped in for player_controls_mobile by PlayerController when the
     "Playback UI style" setting is "Compact"). Keeps the ids of the standard bar:
       title (left) ................ elapsed / total (right)
       full width timeline with the time above the playhead
       [ list  more ]   [ backward  play  forward ]   [ subtitles  audio  video ]
     No Controls button / second button row: every button is always on the playback row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/control_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentBottom="true"
    android:background="@drawable/mobile_player_gradient"
    android:orientation="vertical"
    android:paddingTop="@dimen/mobile_controls_padding_top"
    android:paddingBottom="@dimen/mobile_controls_padding_bottom"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/mobile_title_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/mobile_controls_title_track_margin"
        android:layout_marginEnd="@dimen/mobile_controls_title_track_margin"
        android:gravity="bottom"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/mobile_video_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingEnd="12dp"
            android:ellipsize="marquee"
            android:gravity="start|center_vertical"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:shadowColor="#99000000"
            android:shadowRadius="3"
            android:singleLine="true"
            android:textAlignment="viewStart"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />
        <ProgressBar
            android:id="@+id/seek_state"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mobile_seek_row"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginStart="@dimen/mobile_controls_title_track_margin"
        android:layout_marginEnd="@dimen/mobile_controls_title_track_margin"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <!-- elapsed time, left of the bar, vertically centred with the bar -->
        <TextView
            android:id="@+id/time_current"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:fontFeatureSettings="tnum"
            android:gravity="center_vertical|end"
            android:includeFontPadding="false"
            android:shadowColor="#99000000"
            android:shadowRadius="3"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
        <com.archos.mediacenter.video.player.TimeLabelSeekBar
            android:id="@+id/seek_progress"
            style="@style/PlayerSliderHorizontal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:progressDrawable="@drawable/mobile_mini_seek_progress"
            android:thumb="@drawable/mobile_mini_seek_thumb"
            android:thumbOffset="0dp"
            android:splitTrack="false"
            android:contentDescription="@string/mobile_player_seek" />
        <!-- total / remaining time, right of the bar; tap toggles total <-> remaining -->
        <TextView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFeatureSettings="tnum"
            android:gravity="center_vertical|start"
            android:includeFontPadding="false"
            android:shadowColor="#99000000"
            android:shadowRadius="3"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/button_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mobile_controls_buttons_height"
        android:layout_marginStart="@dimen/mobile_controls_title_track_margin"
        android:layout_marginEnd="@dimen/mobile_controls_title_track_margin"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <LinearLayout
            android:id="@+id/mobile_transport"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageButton
                android:id="@+id/backward"
                style="@style/MobilePlayerButton"
                android:padding="8dp"
                android:contentDescription="@string/mobile_player_backward"
                app:srcCompat="@drawable/mobile_ic_rewind" />
            <ImageButton
                android:id="@+id/pause"
                style="@style/MobilePlayerButton"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:padding="8dp"
                android:contentDescription="@string/play_selection"
                app:srcCompat="@drawable/mobile_ic_play" />
            <ImageButton
                android:id="@+id/forward"
                style="@style/MobilePlayerButton"
                android:padding="8dp"
                android:contentDescription="@string/mobile_player_forward"
                app:srcCompat="@drawable/mobile_ic_forward" />
        </LinearLayout>
        <!-- left aligned: "List" (episodes of the season, or the videos in the folder), then "More" -->
        <LinearLayout
            android:id="@+id/mobile_left_buttons"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageButton
                android:id="@+id/mobile_list"
                style="@style/MobilePlayerButton"
                android:contentDescription="@string/mobile_player_list"
                app:srcCompat="@drawable/mobile_ic_list" />
            <ImageButton
                android:id="@+id/mobile_more"
                style="@style/MobilePlayerButton"
                android:contentDescription="@string/mobile_player_more"
                app:srcCompat="@drawable/mobile_player_more" />
        </LinearLayout>
        <!-- right aligned: subtitles, audio, video -->
        <LinearLayout
            android:id="@+id/mobile_right_buttons"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageButton
                android:id="@+id/mobile_subtitles"
                style="@style/MobilePlayerButton"
                android:contentDescription="@string/menu_subtitles"
                app:srcCompat="@drawable/mobile_ic_subtitle" />
            <ImageButton
                android:id="@+id/mobile_audio"
                style="@style/MobilePlayerButton"
                android:contentDescription="@string/menu_audio"
                app:srcCompat="@drawable/mobile_ic_audio" />
            <ImageButton
                android:id="@+id/mobile_video_fit"
                style="@style/MobilePlayerButton"
                android:contentDescription="@string/phone_video_menu"
                app:srcCompat="@drawable/ic_display_settings_24" />
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
