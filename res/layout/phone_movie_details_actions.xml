<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:gravity="start" android:layout_gravity="bottom" app:cardCornerRadius="@dimen/video_info_cardview_corner" app:cardElevation="@dimen/video_info_cardview_elevation" android:layout_height="wrap_content" android:orientation="vertical" tools:ignore="InconsistentLayout" android:layout_width="match_parent">
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/play" android:background="@drawable/transparent_ripple" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="15dip" android:drawableStart="@drawable/button_icon_play" android:paddingBottom="15dip" android:text="@string/play_from_beginning" android:visibility="visible" android:layout_width="wrap_content" android:gravity="center" android:minHeight="48dp" android:textSize="13sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/resume" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="15dip" android:drawableStart="@drawable/button_icon_resume" android:paddingBottom="15dip" android:background="@drawable/transparent_ripple" android:gravity="center" android:text="@string/resume" android:visibility="visible" android:layout_width="wrap_content" android:minHeight="48dp" android:textSize="13sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/remote_resume" android:layout_height="wrap_content" android:paddingStart="16dp" android:drawableStart="@drawable/button_icon_network" android:paddingEnd="16dp" android:paddingTop="15dip" android:paddingBottom="15dip" android:background="@drawable/transparent_ripple" android:gravity="center" android:text="@string/remote_resume" android:visibility="visible" android:layout_width="wrap_content" android:minHeight="48dp" android:textSize="13sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/next_episode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/transparent_ripple" android:gravity="center" android:paddingStart="16dp" android:paddingTop="15dip" android:paddingEnd="16dp" android:paddingBottom="15dip" android:text="@string/next_episode" android:visibility="gone" android:minHeight="48dp" android:textSize="13sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/list_episodes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/transparent_ripple" android:gravity="center" android:paddingStart="16dp" android:paddingTop="15dip" android:paddingEnd="16dp" android:paddingBottom="15dip" android:text="@string/list_episodes" android:visibility="gone" android:minHeight="48dp" android:textSize="13sp" android:textColor="#FFFFFF" />
        </LinearLayout>
    </HorizontalScrollView>
</androidx.cardview.widget.CardView>