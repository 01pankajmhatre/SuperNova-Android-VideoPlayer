<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" tools:ignore="InconsistentLayout">

    <com.archos.mediacenter.video.browser.BrowserLayout android:id="@+id/drawer_layout" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:fitsSystemWindows="true">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">


            <androidx.appcompat.widget.Toolbar android:id="@+id/main_toolbar" android:layout_alignParentTop="true" android:layout_height="wrap_content" android:layout_width="match_parent" android:background="@color/leanback_background_transparent" android:minHeight="?attr/actionBarSize" android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" app:popupTheme="@style/ThemeOverlay.AppCompat.Dark" app:titleTextAppearance="@style/ToolbarTitle" />



            <androidx.fragment.app.FragmentContainerView android:id="@+id/content" android:layout_below="@+id/main_toolbar" android:layout_alignParentBottom="true" android:layout_width="match_parent" android:layout_height="match_parent" />

            
            <LinearLayout android:layout_width="match_parent" android:id="@+id/category_container" android:fitsSystemWindows="true" android:background="#0B1220" android:layout_height="match_parent" android:orientation="vertical" android:layout_below="@id/main_toolbar" android:layout_alignParentBottom="true" android:tag="phone_home">

            

            <androidx.fragment.app.FragmentContainerView android:id="@+id/category" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:name="com.archos.mediacenter.video.browser.BrowserCategoryVideo" />

            

            
        </LinearLayout>

        



        




    <ImageView android:id="@+id/private_mode_indicator" android:layout_width="@dimen/private_mode_indicator_size" android:layout_height="@dimen/private_mode_indicator_size" android:layout_alignParentBottom="true" android:layout_alignParentEnd="true" android:layout_margin="@dimen/private_mode_indicator_margin" android:src="@drawable/ic_incognito" android:visibility="gone" android:alpha="0.6" android:importantForAccessibility="no" android:contentDescription="@null" />

        </RelativeLayout>

        

        </com.archos.mediacenter.video.browser.BrowserLayout>



</FrameLayout>