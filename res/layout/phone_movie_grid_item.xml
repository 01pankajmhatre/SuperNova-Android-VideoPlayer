<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/phone_movie_card" android:layout_width="match_parent"
    android:layout_height="wrap_content" app:cardCornerRadius="8dp" app:cardElevation="0dp"
    app:cardBackgroundColor="#2B3A4F" android:descendantFocusability="blocksDescendants">
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <FrameLayout android:id="@+id/phone_movie_poster" android:layout_width="match_parent"
                android:layout_height="108dp">
                <ImageView android:id="@+id/thumbnail" android:layout_width="match_parent"
                    android:layout_height="match_parent" android:scaleType="centerCrop"
                    android:contentDescription="@null" />
                <ImageView android:id="@+id/watched_status" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_gravity="top|end"
                    android:src="@drawable/watched_icon_corner" android:contentDescription="@null" />
                <ImageView android:id="@+id/pinned_icon" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_gravity="top|start"
                    android:src="@drawable/pinned_icon_corner" android:visibility="gone" android:contentDescription="@null" />
                <ProgressBar android:id="@+id/resume_notif" style="@style/BrowserResumeSlider"
                    android:layout_width="match_parent" android:layout_height="4dp"
                    android:layout_gravity="bottom" android:indeterminate="false"
                    android:visibility="gone" />
            </FrameLayout>
            <LinearLayout android:id="@+id/phone_card_panel" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:background="#2B3A4F" android:padding="6dp">
                <TextView android:id="@+id/name" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minLines="1" android:maxLines="2"
                    android:ellipsize="end" android:paddingTop="2dp" android:textSize="10sp"
                    android:textStyle="bold" android:textColor="#FFFFFF" />
                <TextView android:id="@+id/info" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:paddingTop="2dp"
                    android:textSize="12sp" android:textColor="#CCFFFFFF" android:maxLines="1"
                    android:ellipsize="end" android:visibility="gone" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingTop="6dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/phone_card_k1" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textSize="8sp" android:textColor="#99FFFFFF" />
                        <TextView android:id="@+id/phone_card_v1" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textSize="9sp" android:textStyle="bold"
                            android:textColor="#FFFFFF" android:maxLines="1" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="end">
                        <TextView android:id="@+id/phone_card_k2" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textSize="8sp" android:textColor="#99FFFFFF" />
                        <TextView android:id="@+id/phone_card_v2" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textSize="9sp" android:textStyle="bold"
                            android:textColor="#FFFFFF" android:maxLines="1" />
                    </LinearLayout>
                </LinearLayout>
                <com.archos.mediacenter.utils.ImageLabel android:id="@+id/bookmark_notif"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:visibility="gone" android:src="@drawable/label_bookmark_small" />
            </LinearLayout>
        </LinearLayout>
        <!-- ticket notches: page-coloured circles half cut by the rounded card, where poster meets panel -->
        <View android:id="@+id/phone_card_notch_start" android:layout_width="12dp" android:layout_height="12dp"
            android:layout_gravity="top|start" android:layout_marginStart="-6dp"
            android:background="@drawable/phone_card_notch" />
        <View android:id="@+id/phone_card_notch_end" android:layout_width="12dp" android:layout_height="12dp"
            android:layout_gravity="top|end" android:layout_marginEnd="-6dp"
            android:background="@drawable/phone_card_notch" />
    </FrameLayout>
</androidx.cardview.widget.CardView>
