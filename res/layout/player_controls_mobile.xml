<?xml version="1.0" encoding="utf-8"?>
<!-- Phone player controls. Same ids as before; only the look changed:
     gradient instead of a solid bar, big title + "elapsed / total" on one line,
     thin timeline with the time floating above the playhead, round transport buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/control_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentBottom="true"
    android:background="@drawable/mobile_player_gradient"
    android:orientation="vertical"
    android:paddingTop="@dimen/mobile_controls_padding_top"
    android:paddingBottom="@dimen/mobile_controls_padding_bottom"
    android:visibility="gone">

    <!-- title and elapsed / total time -->
    <LinearLayout
        android:id="@+id/mobile_title_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/mobile_controls_title_height"
        android:layout_marginStart="@dimen/mobile_controls_title_track_margin"
        android:layout_marginEnd="@dimen/mobile_controls_title_track_margin"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <com.archos.mediacenter.video.player.StandardPlaybackTitleView
            android:id="@+id/mobile_video_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingEnd="12dp"
            android:ellipsize="marquee"
            android:gravity="start|center_vertical"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:textAlignment="viewStart"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
        <ProgressBar
            android:id="@+id/seek_state"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Timeline row: elapsed time | seek bar | total time. The top inset reserves room for the
         floating play-icon + time label above the playhead. -->
    <LinearLayout
        android:id="@+id/mobile_seek_row"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mobile_controls_seek_height"
        android:layout_marginStart="@dimen/mobile_controls_title_track_margin"
        android:layout_marginEnd="@dimen/mobile_controls_title_track_margin"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/time_current"
            android:gravity="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="24dp"
            android:minWidth="32dp"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
        <com.archos.mediacenter.video.player.TimeLabelSeekBar
            android:id="@+id/seek_progress"
            style="@style/PlayerSliderHorizontal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="@dimen/mobile_controls_seek_padding_top"
            android:paddingBottom="0dp"
            android:progressDrawable="@drawable/mobile_seek_progress"
            android:thumb="@drawable/mobile_seek_thumb"
            android:thumbOffset="0dp"
            android:splitTrack="false"
            android:contentDescription="@string/mobile_player_seek" />
        <TextView
            android:id="@+id/time"
            android:gravity="start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="24dp"
            android:minWidth="48dp"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Centered transport and a right-aligned controls pill. -->
    <LinearLayout
        android:id="@+id/mobile_buttons_area"
        android:translationY="-6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/mobile_controls_title_track_margin"
        android:layout_marginEnd="@dimen/mobile_controls_title_track_margin"
        android:layout_marginTop="@dimen/mobile_controls_buttons_margin_top"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/button_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/mobile_controls_buttons_height"
            android:layout_marginBottom="@dimen/mobile_button_bar_margin_bottom">
            <com.archos.mediacenter.video.player.StandardPlaybackStatusView
                android:id="@+id/mobile_title_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/mobile_transport"
                android:layout_centerVertical="true"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/mobile_transport"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageButton
                    android:id="@+id/backward"
                    style="@style/MobilePlayerButton"
                    android:padding="8dp"
                    android:contentDescription="@string/mobile_player_backward"
                    app:srcCompat="@drawable/mobile_ic_rewind" />
                <ImageButton
                    android:id="@+id/pause"
                    style="@style/MobilePlayerButton"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:padding="8dp"
                    android:contentDescription="@string/play_selection"
                    app:srcCompat="@drawable/mobile_ic_play" />
                <ImageButton
                    android:id="@+id/forward"
                    style="@style/MobilePlayerButton"
                    android:padding="8dp"
                    android:contentDescription="@string/mobile_player_forward"
                    app:srcCompat="@drawable/mobile_ic_forward" />
            </LinearLayout>
            <include
                layout="@layout/mobile_playback_controls_pill"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/mobile_controls_buttons_height"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="@dimen/mobile_controls_pill_end_margin"
                android:layout_centerVertical="true" />
        </RelativeLayout>


    </LinearLayout>
</LinearLayout>
