<?xml version="1.0" encoding="utf-8"?>
<!-- Phone / D-pad number row:  title  <  value  >  reset.
     The row is the focus stop: Left / Right change the value, Center / Enter resets it. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/SubtitlePanel.Row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:descendantFocusability="blocksDescendants"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/sp_label"
        style="@style/SubtitlePanel.Label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="2" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layoutDirection="ltr"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/sp_minus"
            style="@style/SubtitlePanel.StepperButton"
            android:contentDescription="@string/subtitle_panel_decrease"
            android:rotation="180"
            app:srcCompat="@drawable/ic_subtitle_chevron" />

        <TextView
            android:id="@+id/sp_value"
            style="@style/SubtitlePanel.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="56dp" />

        <ImageView
            android:id="@+id/sp_plus"
            style="@style/SubtitlePanel.StepperButton"
            android:contentDescription="@string/subtitle_panel_increase"
            app:srcCompat="@drawable/ic_subtitle_chevron" />

        <ImageView
            android:id="@+id/sp_reset"
            style="@style/SubtitlePanel.StepperButton"
            android:contentDescription="@string/subtitle_panel_reset_value"
            app:srcCompat="@drawable/ic_subtitle_reset" />
    </LinearLayout>
</LinearLayout>
