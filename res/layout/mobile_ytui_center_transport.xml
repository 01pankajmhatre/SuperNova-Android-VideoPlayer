<?xml version="1.0" encoding="utf-8"?>
<!-- YouTube-style phone controls: backward / play / forward in the middle of the screen (setting
     "Buttons in the center"). The play button is bigger than the other two. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mobile_ytui_center_transport"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_centerInParent="true"
    android:gravity="center"
    android:orientation="horizontal"
    android:visibility="gone">
    <ImageButton
        android:id="@+id/backward"
        style="@style/MobilePlayerButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/mobile_ytui_circle_button"
        android:padding="14dp"
        android:contentDescription="@string/mobile_player_backward"
        app:srcCompat="@drawable/mobile_ic_rewind" />
    <ImageButton
        android:id="@+id/pause"
        style="@style/MobilePlayerButton"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/mobile_ytui_circle_button"
        android:padding="22dp"
        android:contentDescription="@string/play_selection"
        app:srcCompat="@drawable/mobile_ic_play" />
    <ImageButton
        android:id="@+id/forward"
        style="@style/MobilePlayerButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/mobile_ytui_circle_button"
        android:padding="14dp"
        android:contentDescription="@string/mobile_player_forward"
        app:srcCompat="@drawable/mobile_ic_forward" />
</LinearLayout>
