<?xml version="1.0" encoding="utf-8"?>
<!-- YouTube-style phone controls (swapped in for player_controls_mobile by PlayerController when the
     "Playback UI style" setting is "YouTube style"). Keeps the ids of the standard bar so the existing
     seek / pause / time / pill logic keeps working:
       timeline across the top, then one row:
       [backward] [play] [forward] [time pill] [title pill] .................. [buttons pill] -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/control_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentBottom="true"
    android:background="@drawable/mobile_player_gradient"
    android:orientation="vertical"
    android:paddingTop="@dimen/mobile_controls_padding_top"
    android:paddingBottom="@dimen/mobile_ytui_controls_padding_bottom"
    android:visibility="gone">

    <!-- full width timeline with a red playhead -->
    <com.archos.mediacenter.video.player.TimeLabelSeekBar
        android:id="@+id/seek_progress"
        style="@style/PlayerSliderHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mobile_ytui_seek_height"
        android:layout_marginStart="@dimen/mobile_ytui_margin"
        android:layout_marginEnd="@dimen/mobile_ytui_margin"
        android:maxHeight="5dp"
        android:minHeight="5dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:progressDrawable="@drawable/mobile_ytui_seek_progress"
        android:thumb="@drawable/mobile_ytui_seek_thumb"
        android:thumbOffset="0dp"
        android:splitTrack="false"
        android:contentDescription="@string/mobile_player_seek" />

    <RelativeLayout
        android:id="@+id/button_bar"
        android:tag="inline_pill"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mobile_controls_buttons_height"
        android:layout_marginStart="@dimen/mobile_ytui_margin"
        android:layout_marginEnd="@dimen/mobile_ytui_margin"
        android:layout_marginTop="2dp">

        <!-- backward, play, forward and the time pill -->
        <LinearLayout
            android:id="@+id/mobile_transport"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageButton
                android:id="@+id/backward"
                style="@style/MobilePlayerButton"
                android:layout_width="@dimen/mobile_controls_buttons_height"
                android:layout_height="@dimen/mobile_controls_buttons_height"
                android:background="@drawable/mobile_ytui_circle_button"
                android:padding="10dp"
                android:contentDescription="@string/mobile_player_backward"
                app:srcCompat="@drawable/mobile_ic_rewind" />
            <ImageButton
                android:id="@+id/pause"
                style="@style/MobilePlayerButton"
                android:layout_width="@dimen/mobile_controls_buttons_height"
                android:layout_height="@dimen/mobile_controls_buttons_height"
                android:layout_marginStart="@dimen/mobile_ytui_gap"
                android:background="@drawable/mobile_ytui_circle_button"
                android:padding="10dp"
                android:contentDescription="@string/play_selection"
                app:srcCompat="@drawable/mobile_ic_play" />
            <ImageButton
                android:id="@+id/forward"
                style="@style/MobilePlayerButton"
                android:layout_width="@dimen/mobile_controls_buttons_height"
                android:layout_height="@dimen/mobile_controls_buttons_height"
                android:layout_marginStart="@dimen/mobile_ytui_gap"
                android:background="@drawable/mobile_ytui_circle_button"
                android:padding="10dp"
                android:contentDescription="@string/mobile_player_forward"
                app:srcCompat="@drawable/mobile_ic_forward" />
            <!-- "elapsed / total"; tap toggles total <-> remaining (same as the standard UI) -->
            <TextView
                android:id="@+id/time_current"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/mobile_controls_buttons_height"
                android:layout_marginStart="@dimen/mobile_ytui_gap"
                android:background="@drawable/mobile_ytui_pill_button"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="88dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- title pill: takes the room between the transport and the buttons pill -->
        <LinearLayout
            android:id="@+id/mobile_title_row"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/mobile_controls_buttons_height"
            android:layout_toEndOf="@id/mobile_transport"
            android:layout_toStartOf="@id/mobile_compact_pill"
            android:layout_marginStart="@dimen/mobile_ytui_gap"
            android:layout_marginEnd="@dimen/mobile_ytui_gap"
            android:background="@drawable/mobile_ytui_pill_button"
            android:clickable="true"
            android:contentDescription="@string/mobile_ytui_file_details"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">
            <ProgressBar
                android:id="@+id/seek_state"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/mobile_video_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:gravity="start|center_vertical"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textAlignment="viewStart"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- right aligned buttons pill -->
        <include
            layout="@layout/mobile_playback_controls_pill"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/mobile_controls_buttons_height"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true" />
    </RelativeLayout>
</LinearLayout>
