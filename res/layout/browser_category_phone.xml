<?xml version="1.0" encoding="utf-8"?>
<!-- Classic phone home: portrait source cards and horizontal media rows.
     The source row can be pinned above the scrolling media rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

<androidx.core.widget.NestedScrollView
    android:id="@+id/home_classic"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:clipToPadding="false"
    android:paddingBottom="16dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- required by ListFragment; the phone home no longer shows the list -->
        <ListView android:id="@android:id/list" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:visibility="gone" />

        <include android:id="@+id/home_sources_row" layout="@layout/home_poster_row" />

        <!-- "Sources" (storages and network) comes first, right below the action bar -->
        <include android:id="@+id/home_network_row" layout="@layout/home_poster_row" android:visibility="gone" />
        <include android:id="@+id/home_recent_row" layout="@layout/home_poster_row" />
        <include android:id="@+id/home_added_row" layout="@layout/home_poster_row" />
        <include android:id="@+id/home_movies_row" layout="@layout/home_poster_row" />
        <include android:id="@+id/home_series_row" layout="@layout/home_poster_row" />
        <include android:id="@+id/home_all_row" layout="@layout/home_poster_row" android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

<!-- Scanning / refreshing status: bottom edge, centred -->
<LinearLayout
    android:id="@+id/home_scan_pill"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/home_scan_pill_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="6dp"
    android:paddingEnd="14dp"
    android:paddingBottom="6dp"
    android:visibility="gone">
    <ProgressBar
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:indeterminate="true" />
    <TextView
        android:id="@+id/home_scan_pill_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:singleLine="true"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp" />
</LinearLayout>
</LinearLayout>
