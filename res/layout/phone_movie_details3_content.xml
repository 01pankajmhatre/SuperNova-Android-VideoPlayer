<?xml version="1.0" encoding="utf-8"?>
<com.github.ksoichiro.android.observablescrollview.ObservableScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/scrollView" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/scroll_content" android:paddingBottom="@dimen/activity_vertical_margin" android:paddingStart="16dp" android:paddingEnd="16dp" android:orientation="vertical">
        <!-- single container (original page background): backdrop, title, rating row, genre, description -->
        <androidx.cardview.widget.CardView android:id="@+id/poster_action_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardCornerRadius="0dp" app:cardElevation="@dimen/video_info_cardview_elevation">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <ImageView android:id="@+id/backdrop_top" android:alpha="0" android:layout_width="match_parent" android:layout_height="wrap_content" android:adjustViewBounds="true" android:layout_marginTop="16dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:scaleType="fitCenter" app:srcCompat="@drawable/genres_banner" android:contentDescription="@null" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/titlebar_content" android:paddingBottom="4dp">
                            <TextView android:id="@+id/title_view" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="32sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="3" />
                        </RelativeLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="6dp">
                            <TextView android:id="@+id/s_e_text_view" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="@dimen/video_info_medium_text" android:textStyle="bold" android:textColor="#FFFFFF" />
                            <TextView android:id="@+id/episode_title_view" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/video_info_margin_half" android:textStyle="italic" android:textSize="@dimen/video_info_medium_text" android:textColor="#FFFFFF" />
                        </LinearLayout>
                        <LinearLayout android:id="@+id/scrap_rating_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingBottom="6dp">
                            <LinearLayout android:id="@+id/content_rating_container" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="10dp" android:background="@drawable/rounded_edges">
                                <TextView android:id="@+id/content_rating" android:textSize="@dimen/video_info_small_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" android:layout_marginBottom="1dp" android:gravity="center_horizontal" android:textAppearance="?android:attr/textAppearanceMedium" android:textStyle="bold" android:textColor="@color/grid_item_background" />
                            </LinearLayout>
                            <TextView android:id="@+id/scrap_date" style="@style/VideoInfoFileInfo" android:layout_marginEnd="10dp" android:singleLine="true" android:textSize="13sp" android:textColor="#DFE7F2" />
                            <TextView android:id="@+id/scrap_duration" style="@style/VideoInfoFileInfo" android:layout_marginEnd="10dp" android:singleLine="true" android:textSize="13sp" android:textColor="#DFE7F2" />
                            <TextView android:id="@+id/scrap_rating" style="@style/VideoInfoFileInfo" android:drawablePadding="2dip" app:drawableLeftCompat="@drawable/little_star" android:gravity="center_vertical" android:singleLine="true" android:textSize="13sp" android:textColor="#DFE7F2" />
                            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                            <LinearLayout android:id="@+id/badge_resolution_container" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:visibility="gone" android:background="@drawable/rounded_edges">
                                <TextView android:id="@+id/badge_resolution" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" android:layout_marginBottom="1dp" android:gravity="center_horizontal" android:text="1080" android:textAppearance="?android:attr/textAppearanceMedium" android:textStyle="bold" android:textSize="@dimen/video_info_small_text" android:textColor="@color/grid_item_background" />
                            </LinearLayout>
                            <LinearLayout android:id="@+id/badge_audio_container" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:visibility="gone" android:background="@drawable/rounded_edges">
                                <TextView android:id="@+id/badge_audio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" android:layout_marginBottom="1dp" android:gravity="center_horizontal" android:text="5.1" android:textAppearance="?android:attr/textAppearanceMedium" android:textStyle="bold" android:textSize="@dimen/video_info_small_text" android:textColor="@color/grid_item_background" />
                            </LinearLayout>
                        </LinearLayout>
                        <TextView android:id="@+id/scrap_genre" style="@style/VideoInfoFileInfo.Title2" android:alpha="1" android:paddingBottom="12dp" android:textSize="13sp" android:textColor="#FFFFFF" />
                        <androidx.cardview.widget.CardView android:id="@+id/scraper_plot_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" app:cardBackgroundColor="@android:color/transparent" app:cardElevation="0dp" app:cardCornerRadius="0dp">
                            <TextView android:id="@+id/scrap_plot" style="@style/VideoInfoFileInfo" android:textStyle="normal" android:textSize="14sp" android:textColor="#FFFFFF" />
                        </androidx.cardview.widget.CardView>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <!-- poster is no longer shown; kept hidden because shared code binds it (colour + thumbnail) -->
        <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone">
            <RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                <ImageView android:id="@+id/poster" android:layout_width="120dp" android:layout_height="180dp" android:contentDescription="@null" />
                <ImageView android:id="@+id/watched_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignEnd="@id/poster" android:layout_alignTop="@id/poster" app:srcCompat="@drawable/watched_icon_corner" android:contentDescription="@null" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
        <include layout="@layout/phone_movie_details3_actions" android:id="@+id/action_buttons_container" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <LinearLayout android:id="@+id/cast_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" android:visibility="gone" />
<androidx.cardview.widget.CardView android:gravity="start" android:layout_gravity="bottom" android:id="@+id/buttons_container" android:layout_marginTop="@dimen/video_info_cardview_top_margin" app:cardCornerRadius="0dp" app:cardElevation="@dimen/video_info_cardview_elevation" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="vertical">
        <Button android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_horizontal|bottom" android:text="@string/leanback_scrap" android:id="@+id/scrap_button" android:layout_centerHorizontal="true" android:layout_alignParentStart="false" android:background="@drawable/transparent_ripple" android:visibility="visible" />
        <Button android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_horizontal|bottom" android:text="@string/video_browser_index_file" android:id="@+id/index_button" android:layout_centerHorizontal="true" android:layout_alignParentStart="false" android:background="@drawable/transparent_ripple" />
    </androidx.cardview.widget.CardView>
    <HorizontalScrollView android:id="@+id/source_container" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:id="@+id/source_layout" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </HorizontalScrollView>
    <include android:layout_width="match_parent" android:layout_height="wrap_content" layout="@layout/video_info2_file" android:id="@+id/info_file_container" android:layout_marginTop="@dimen/video_info_cardview_top_margin" />
    <include android:layout_width="match_parent" android:layout_height="wrap_content" layout="@layout/video_info2_subtitles" android:layout_gravity="center_horizontal|bottom" android:id="@+id/subtitles_container" android:layout_marginTop="@dimen/video_info_cardview_top_margin" />
    <!-- scrap_details_container removed from page 3: views kept only so shared code can bind them -->
    <LinearLayout android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone">
        <include android:layout_width="match_parent" android:layout_height="wrap_content" layout="@layout/video_info2_scraper" android:id="@+id/scraper_container" />
    </LinearLayout>
    <!-- former three-dot menu actions, shown as buttons -->
    <LinearLayout android:id="@+id/menu_buttons_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="@dimen/video_info_cardview_top_margin" />
    </LinearLayout>
</com.github.ksoichiro.android.observablescrollview.ObservableScrollView>
