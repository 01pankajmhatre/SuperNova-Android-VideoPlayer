<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingTop="4dp" android:paddingBottom="4dp"
    android:descendantFocusability="afterDescendants">
    <ImageView android:id="@+id/thumbnail" android:layout_width="88dp"
        android:layout_height="132dp" android:scaleType="centerCrop"
        android:background="#263E42" android:importantForAccessibility="no"
        android:contentDescription="@null" />
    <LinearLayout android:id="@+id/movie_reel_details" android:layout_width="0dp"
        android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="180dp"
        android:orientation="vertical" android:gravity="center_vertical"
        android:padding="12dp" android:background="#40FFFFFF">
        <TextView android:id="@+id/name" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="22sp"
            android:textColor="#FFFFFF" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/movie_reel_meta" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:textColor="#E0FFFFFF" android:textSize="13sp" android:maxLines="2"
            android:ellipsize="end" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp">
            <Button android:id="@+id/movie_reel_play" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="48dp" android:minWidth="0dp"
                android:text="@string/movie_reel_play" android:textSize="12sp"
                android:textColor="#FFFFFF" android:background="?attr/selectableItemBackground" />
            <Button android:id="@+id/movie_reel_info" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="48dp" android:minWidth="0dp"
                android:text="@string/movie_reel_info" android:textSize="12sp"
                android:textColor="#FFFFFF" android:background="?attr/selectableItemBackground" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
