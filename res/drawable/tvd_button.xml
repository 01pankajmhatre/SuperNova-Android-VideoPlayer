<?xml version="1.0" encoding="utf-8"?>
<!-- pill action button, TV details style; white ring + fill when focused (remote) or pressed -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape android:shape="rectangle"><solid android:color="#59FFFFFF" /><stroke android:width="3dp" android:color="#FFFFFF" /><corners android:radius="22dp" /></shape></item>
    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="#59FFFFFF" /><stroke android:width="2dp" android:color="#FFFFFF" /><corners android:radius="22dp" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="#CC1A1A1A" /><stroke android:width="1dp" android:color="#80FFFFFF" /><corners android:radius="22dp" /></shape></item>
</selector>
