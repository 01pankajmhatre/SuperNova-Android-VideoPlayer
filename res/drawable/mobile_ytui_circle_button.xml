<?xml version="1.0" encoding="utf-8"?>
<!-- YouTube-style phone player: round dark button (same black as the controls pill) with a light press/focus overlay. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#D9000000" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <selector>
            <item android:state_pressed="true"><shape android:shape="oval"><solid android:color="#55FFFFFF" /></shape></item>
            <item android:state_focused="true"><shape android:shape="oval"><solid android:color="#55FFFFFF" /></shape></item>
            <item><shape android:shape="oval"><solid android:color="#00000000" /></shape></item>
        </selector>
    </item>
</layer-list>
