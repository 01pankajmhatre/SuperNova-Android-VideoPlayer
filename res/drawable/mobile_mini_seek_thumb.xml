<?xml version="1.0" encoding="utf-8"?>
<!-- Compact UI seek thumb: invisible unless the remote's focus is on the seek bar. It is smaller than the
     standard one on purpose: TimeLabelSeekBar puts the floating time just above the thumb, so a smaller
     thumb brings the time closer to the seek bar. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <size android:width="14dp" android:height="14dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <size android:width="8dp" android:height="8dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
