<?xml version="1.0" encoding="utf-8"?>
<!-- YouTube-style phone player: dark pill (same black as the controls pill) with a light press/focus overlay. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape><solid android:color="#D9000000" /><corners android:radius="22dp" /></shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <selector>
            <item android:state_pressed="true"><shape><solid android:color="#55FFFFFF" /><corners android:radius="22dp" /></shape></item>
            <item android:state_focused="true"><shape><solid android:color="#55FFFFFF" /><corners android:radius="22dp" /></shape></item>
            <item><shape><solid android:color="#00000000" /><corners android:radius="22dp" /></shape></item>
        </selector>
    </item>
</layer-list>
